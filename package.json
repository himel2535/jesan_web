{
  "name": "jesan-web",
  "version": "0.1.0",
  "private": true,
  "description": "Jesan Enterprise multi-business ERP platform - web frontend",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "predev": "node scripts/dev-cache-guard.mjs",
    "dev": "next dev",
    "dev:clean": "node scripts/dev-cache-guard.mjs --force && next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "clsx": "2.1.1",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.11.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}

# Copy to .env.local and adjust. Never put real secrets in this file.

# Server-only: jesan-api's real address. The browser never calls it directly; it calls this
# site's /api/v1/*, which Next proxies here. Read at BUILD time (rewrites): set it before `next build`.
API_INTERNAL_URL=http://localhost:4000/api/v1

# Optional: this site's public origin, e.g. https://app.example.com. Sent as the Origin header when
# the server refreshes a session; when empty it is taken from the request. jesan-api's CORS_ORIGIN
# must contain this origin.
APP_ORIGIN=
